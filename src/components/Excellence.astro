---
// Sección: Ejes de Excelencia Operativa — acordeón con foto real por eje
import { Image } from 'astro:assets';
import fotoGenetica from '../assets/galeria/eje-genetica.jpg';
import fotoSilvo from '../assets/galeria/eje-silvopastoril.jpg';
import fotoBienestar from '../assets/galeria/eje-bienestar.jpg';

const ejes = [
  {
    id:       'genetica',
    numero:   '01',
    titulo:   'Mejoramiento Genético',
    subtitulo:'Ciencia aplicada al campo',
    cuerpo:   'Nuestros programas de selección genética priorizan alta fertilidad, precocidad sexual y ganancia diaria de peso superior. Utilizamos protocolos de biotecnología reproductiva que elevan los índices zootécnicos de cada generación, garantizando rentabilidad y calidad cárnica sostenida.',
    foto:     fotoGenetica,
    alt:      'Hato de ganado rojo reunido en el corral de la hacienda',
  },
  {
    id:       'silvopastoril',
    numero:   '02',
    titulo:   'Sistemas Silvopastoriles',
    subtitulo:'No cultivamos vacas, cultivamos bosques y suelos',
    cuerpo:   'Los Sistemas Silvopastoriles Intensivos (SSPi) implementados en RB Ganadería revierten activamente la degradación del suelo, protegen la biodiversidad nativa y aumentan la eficiencia del engorde. Nuestras praderas son ecosistemas productivos, no monocultivos.',
    foto:     fotoSilvo,
    alt:      'Crías de ganado en el corral con colinas verdes al fondo',
  },
  {
    id:       'bienestar',
    numero:   '03',
    titulo:   'Ética y Bienestar Animal',
    subtitulo:'Los 5 principios universales',
    cuerpo:   'Adherimos estrictamente a los cinco principios internacionales de bienestar animal: libre de hambre y sed, libre de incomodidad, libre de dolor y enfermedad, libre de expresar su comportamiento natural y libre de miedo y angustia. Esto no es marketing; es nuestro estándar operativo diario.',
    foto:     fotoBienestar,
    alt:      'Ganado en el corral techado con vista abierta al valle',
  },
];
---

<section
  id="excelencia"
  class="relative py-20 md:py-28 px-5 sm:px-6 bg-superficie-2 border-t border-linea-acento"
  aria-labelledby="excelencia-titulo"
>
  <div class="max-w-6xl mx-auto">

    <div class="mb-10 md:mb-14" data-reveal>
      <h2 id="excelencia-titulo" class="font-serif text-3xl sm:text-4xl md:text-5xl leading-[1.15] max-w-xl text-tinta text-balance">
        La ciencia detrás de cada decisión productiva
      </h2>
    </div>

    <!-- Acordeón: horizontal en desktop, apilado en móvil -->
    <div class="ejes flex flex-col md:flex-row border border-linea-acento" data-reveal style="--d: 0.1s;">
      {ejes.map((eje, i) => (
        <article class:list={['eje', { 'is-open': i === 0 }]} data-index={i}>
          <Image
            src={eje.foto}
            alt={eje.alt}
            widths={[640, 960, 1280]}
            sizes="(min-width: 1152px) 720px, 100vw"
            loading="lazy"
            class="eje-foto"
          />
          <div class="eje-velo" aria-hidden="true"></div>

          <h3 class="eje-cabecera">
            <button
              type="button"
              class="eje-boton"
              aria-expanded={i === 0 ? 'true' : 'false'}
              aria-controls={`eje-panel-${eje.id}`}
              id={`eje-boton-${eje.id}`}
            >
              <span class="eje-numero" aria-hidden="true">{eje.numero}</span>
              <span class="eje-titulo">{eje.titulo}</span>
              <span class="eje-subtitulo">{eje.subtitulo}</span>
              <svg class="eje-icono" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path class="eje-icono-v" stroke-linecap="round" d="M12 5v14" />
                <path stroke-linecap="round" d="M5 12h14" />
              </svg>
            </button>
          </h3>

          <div
            class="eje-panel"
            id={`eje-panel-${eje.id}`}
            role="region"
            aria-labelledby={`eje-boton-${eje.id}`}
            inert={i !== 0}
          >
            <div class="eje-panel-inner">
              <div class="w-8 h-px mb-5 bg-oro" aria-hidden="true"></div>
              <p class="font-body text-base leading-[1.8] text-tinta">
                {eje.cuerpo}
              </p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .eje {
    position: relative;
    overflow: hidden;
    background: #0B0A09;
    border-top: 1px solid rgba(139, 26, 26, 0.35);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 120px;
  }
  .eje:first-child { border-top: none; }

  .eje :global(.eje-foto) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.32;
    transform: scale(1.03);
    transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .eje.is-open :global(.eje-foto) { opacity: 0.6; transform: scale(1); }

  /* Velo: asegura contraste del texto sobre cualquier zona de la foto */
  .eje-velo {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to top, rgba(11,10,9,0.94) 0%, rgba(11,10,9,0.7) 45%, rgba(11,10,9,0.35) 100%);
  }

  .eje-cabecera { position: relative; margin: 0; }

  .eje-boton {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    column-gap: 1rem;
    width: 100%;
    min-height: 44px;
    text-align: left;
    cursor: pointer;
    padding: 1.5rem 1.5rem 1.25rem;
    background: transparent;
    border: none;
    color: #F0EBE1;
  }
  .eje-numero {
    grid-column: 1 / -1;
    font: 500 0.75rem/1 'Poppins', sans-serif;
    letter-spacing: 0.3em;
    color: #E0B86A;
    margin-bottom: 0.9rem;
  }
  .eje-titulo {
    font: 600 1.25rem/1.3 'Poppins', sans-serif;
    text-wrap: balance;
  }
  .eje-subtitulo {
    grid-column: 1;
    margin-top: 0.5rem;
    font: italic 300 0.9rem/1.5 'Inter', sans-serif;
    color: #C2BCB0;
  }
  .eje-icono {
    grid-column: 2;
    grid-row: 2 / span 2;
    align-self: start;
    width: 1.5rem;
    height: 1.5rem;
    margin-top: 0.15rem;
    color: #E0B86A;
  }
  .eje-icono-v { transform-origin: center; transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s; }
  .eje.is-open .eje-icono-v { transform: scaleY(0); opacity: 0; }
  .eje-boton:hover .eje-titulo { color: #E0B86A; }

  /* Panel: altura animada con grid-template-rows */
  .eje-panel {
    position: relative;
    display: grid;
    grid-template-rows: 0fr;
    visibility: hidden;
    transition: grid-template-rows 0.55s cubic-bezier(0.16, 1, 0.3, 1), visibility 0s linear 0.55s;
  }
  .eje.is-open .eje-panel {
    grid-template-rows: 1fr;
    visibility: visible;
    transition: grid-template-rows 0.55s cubic-bezier(0.16, 1, 0.3, 1), visibility 0s;
  }
  .eje-panel-inner {
    min-height: 0;
    overflow: hidden;
    padding: 0 1.5rem;
  }
  .eje.is-open .eje-panel-inner { padding-bottom: 1.75rem; }

  @media (min-width: 768px) {
    .eje {
      flex: 1 1 0;
      min-width: 0;
      min-height: 460px;
      border-top: none;
      border-left: 1px solid rgba(139, 26, 26, 0.35);
      transition: flex-grow 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .eje:first-child { border-left: none; }
    .eje.is-open { flex-grow: 3; }
    .eje-boton { padding: 2.25rem 2rem 1.5rem; }
    .eje-panel-inner { padding: 0 2rem; }
    .eje.is-open .eje-panel-inner { padding-bottom: 2.25rem; }
    .eje-titulo { font-size: 1.4rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .eje, .eje :global(.eje-foto), .eje-panel, .eje-icono-v { transition: none; }
  }
</style>

<script>
  const ejes = document.querySelectorAll<HTMLElement>('.eje');

  const open = (idx: number) => {
    ejes.forEach((eje, i) => {
      const active = i === idx;
      eje.classList.toggle('is-open', active);
      eje.querySelector('.eje-boton')?.setAttribute('aria-expanded', String(active));
      eje.querySelector('.eje-panel')?.toggleAttribute('inert', !active);
    });
  };

  ejes.forEach((eje, i) => {
    eje.querySelector('.eje-boton')?.addEventListener('click', () => open(i));
  });
</script>
