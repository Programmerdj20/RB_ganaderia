---
// Sección: La ciencia detrás del Brahman Rojo — tres capítulos editoriales, foto + texto + registro de datos.
// Cada dato lleva su fuente visible; si cambia una cifra, actualizar también `fuente`.
import { Image } from 'astro:assets';
import fotoGenetica from '../assets/galeria/eje-genetica.jpg';
import fotoSilvo from '../assets/galeria/eje-silvopastoril.jpg';
import fotoBienestar from '../assets/galeria/eje-bienestar.jpg';

const capitulos = [
  {
    id:     'tropico',
    titulo: 'Hecho para el trópico',
    lead:   'El Brahman desciende de cebuinos de la India que se adaptaron durante siglos al calor. Su cuerpo regula la temperatura mejor que el de las razas europeas: piel pigmentada que frena la radiación, pelo corto y brillante que refleja el sol y más glándulas sudoríparas.',
    foto:   fotoGenetica,
    alt:    'Hato de ganado rojo reunido en el corral al aire libre',
    datos: [
      { valor: '85 %',   texto: 'del calor corporal se disipa por sudor cuando la temperatura supera los 30 °C.', fuente: 'Frontiers in Genetics, 2023' },
      { valor: '+95 %',  texto: 'del hato cebú colombiano es Brahman, entre variedades roja y gris.',            fuente: 'CONtexto Ganadero / Asocebú' },
    ],
  },
  {
    id:     'genetica',
    titulo: 'Genética con propósito',
    lead:   'El Brahman Rojo nace de la selección sobre líneas Gyr e Indubrasil, con énfasis en la habilidad materna. Hoy se mejora con biotecnología reproductiva: transferencia de embriones y fecundación in vitro con donadoras de alta selección.',
    foto:   fotoSilvo,
    alt:    'Crías de ganado en el corral con colinas verdes al fondo',
    datos: [
      { valor: '220–250 kg', texto: 'de peso al destete en crías de vacas Brahman Rojo.',                                        fuente: 'CONtexto Ganadero' },
      { valor: '30 → 20',    texto: 'meses a la primera preñez en hembras con buena alimentación.',                              fuente: 'CONtexto Ganadero' },
      { valor: '50–55 %',    texto: 'de rendimiento en canal, equivalente entre toros rojos y blancos.',                         fuente: 'CONtexto Ganadero' },
    ],
  },
  {
    id:     'bienestar',
    titulo: 'Bienestar y suelo vivo',
    lead:   'Producir bien exige cuidar al animal y a la tierra que lo sostiene. La normativa colombiana exige animales libres de hambre y sed, molestias, dolor, temor y con posibilidad de expresar su comportamiento natural. Los sistemas silvopastoriles, con árboles y arbustos dentro de la pradera, dan sombra, alimento y suelo cubierto.',
    foto:   fotoBienestar,
    alt:    'Ganado en el corral techado con vista abierta al valle',
    datos: [
      { valor: '650 g',  texto: 'de ganancia diaria de peso en sistemas silvopastoriles de Antioquia.',                 fuente: 'Universidad Nacional, sede Medellín' },
      { valor: '+70 %',  texto: 'de carbono capturado frente a la ganadería tradicional.',                              fuente: 'Universidad Nacional, sede Medellín' },
    ],
  },
];
---

<section
  id="excelencia"
  class="relative py-20 md:py-32 px-5 sm:px-6 bg-superficie-2"
  aria-labelledby="excelencia-titulo"
>
  <div class="max-w-6xl mx-auto">

    <div class="grid md:grid-cols-12 gap-6 md:gap-16 mb-16 md:mb-28" data-reveal>
      <h2 id="excelencia-titulo" class="md:col-span-7 font-serif text-3xl sm:text-4xl md:text-5xl leading-[1.15] text-tinta text-balance">
        La ciencia detrás de una raza hecha para el trópico
      </h2>
      <p class="md:col-span-5 md:pt-3 font-body text-lg leading-relaxed text-tinta-2" style="text-wrap: pretty;">
        Adaptación, genética y manejo: tres razones por las que el Brahman Rojo rinde donde otras razas se resienten.
      </p>
    </div>

    <div class="flex flex-col gap-20 md:gap-32">
      {capitulos.map((c, i) => (
        <article class="capitulo grid md:grid-cols-12 gap-8 md:gap-16 items-center" aria-labelledby={`cap-${c.id}`}>
          <figure
            class:list={['capitulo-foto md:col-span-7 m-0', { 'md:order-2': i % 2 === 1 }]}
          >
            <Image
              src={c.foto}
              alt={c.alt}
              widths={[640, 960, 1280]}
              sizes="(min-width: 1152px) 660px, (min-width: 768px) 58vw, 100vw"
              loading="lazy"
              class="w-full aspect-[4/3] object-cover"
            />
          </figure>

          <div class:list={['md:col-span-5', { 'md:order-1': i % 2 === 1 }]} data-reveal>
            <h3 id={`cap-${c.id}`} class="font-sans font-semibold text-3xl md:text-[2.15rem] leading-[1.15] text-tinta mb-5 text-balance">
              {c.titulo}
            </h3>
            <div class="w-10 h-px bg-oro mb-6" aria-hidden="true"></div>
            <p class="font-body text-base leading-[1.8] text-tinta-2 mb-8" style="text-wrap: pretty;">
              {c.lead}
            </p>

            <dl class="registro">
              {c.datos.map((d) => (
                <div class="registro-fila">
                  <dt class="registro-valor">{d.valor}</dt>
                  <dd class="registro-texto">
                    {d.texto}
                    <span class="registro-fuente">{d.fuente}</span>
                  </dd>
                </div>
              ))}
            </dl>
          </div>
        </article>
      ))}
    </div>

    <p class="mt-20 md:mt-28 pt-6 border-t border-linea font-body text-[0.8125rem] leading-relaxed text-tinta-3 max-w-3xl">
      Marco normativo de bienestar animal: Decreto 1071 de 2015 y Resolución 253 de 2020 del Ministerio de Agricultura. Termorregulación: Frontiers in Genetics 2023 (estudio en 319 novillas) y Oklahoma State University, Breeds of Livestock.
    </p>
  </div>
</section>

<style>
  .capitulo-foto { overflow: hidden; background: #0B0A09; }
  .capitulo-foto :global(img) { display: block; }

  /* Registro de datos: filas separadas por filetes, sin tarjetas */
  .registro { margin: 0; border-top: 1px solid rgba(240, 235, 225, 0.1); }
  .registro-fila {
    display: grid;
    grid-template-columns: minmax(6.5rem, 10rem) 1fr;
    column-gap: 1.25rem;
    align-items: baseline;
    padding: 1rem 0;
    border-bottom: 1px solid rgba(240, 235, 225, 0.1);
  }
  /* El oro señala una sola cifra por capítulo, la primera; las demás son de apoyo */
  .registro-valor {
    font: 500 1.3rem/1.1 'Playfair Display', Georgia, serif;
    color: #F0EBE1;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .registro-fila:first-child .registro-valor {
    font-size: 1.75rem;
    color: #E0B86A;
  }
  @media (max-width: 30rem) {
    .registro-fila { grid-template-columns: 1fr; row-gap: 0.3rem; }
  }
  .registro-texto {
    margin: 0;
    font: 400 0.9rem/1.55 'Inter', system-ui, sans-serif;
    color: #C2BCB0;
  }
  .registro-fuente {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.8125rem;
    color: #A09A8E;
  }

  /* Un solo momento de movimiento: la foto se revela con un clip-path ligado al scroll */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .capitulo-foto {
        animation: revelarFoto linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 70%;
      }
      @keyframes revelarFoto {
        from { clip-path: inset(0 0 100% 0); }
        to   { clip-path: inset(0); }
      }
    }
  }
</style>
