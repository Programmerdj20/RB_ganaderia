---
// Footer — firma discreta de RB Ganadería, índice de secciones y fuentes de los datos
const secciones = [
  { href: '#fundacion',  label: 'La raza' },
  { href: '#excelencia', label: 'La ciencia' },
  { href: '#hato',   label: 'El hato' },
  { href: '#impacto',    label: 'Territorio' },
  { href: '#calidad',    label: 'Exportación' },
];
const anio = new Date().getFullYear();
---

<footer
  class="relative pt-14 sm:pt-20 pb-8 sm:pb-10 px-5 sm:px-6 overflow-hidden bg-[#020101] border-t border-linea-acento"
  aria-label="Pie de página"
>
  <!-- Línea carmesí superior — misma firma del hero -->
  <div
    class="absolute top-0 left-0 right-0 h-px pointer-events-none"
    style="background: linear-gradient(to right, transparent, var(--acento) 30%, var(--acento) 70%, transparent);"
    aria-hidden="true"
  ></div>

  <div class="relative max-w-6xl mx-auto">

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-10 mb-10 sm:mb-14 pb-10 sm:pb-14 border-b border-linea">
      <div class="flex items-center gap-5">
        <a href="#inicio" aria-label="RB Ganadería — volver al inicio" class="shrink-0">
          <img src="/rb-logo.webp" alt="RB Ganadería" width="264" height="348" loading="lazy" class="h-28 sm:h-36 w-auto" />
        </a>
        <div>
          <p class="font-serif text-xl text-tinta mb-1">El Brahman Rojo colombiano</p>
          <p class="font-body text-sm text-tinta-2">Una iniciativa de RB Ganadería</p>
        </div>
      </div>

      <nav aria-label="Secciones del sitio">
        <ul class="flex flex-wrap gap-x-7 gap-y-1">
          {secciones.map((s) => (
            <li>
              <a
                href={s.href}
                class="font-sans text-xs tracking-[0.2em] uppercase flex items-center min-h-11 text-tinta-2 transition-colors duration-300 hover:text-oro-claro"
              >
                {s.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="flex flex-col sm:flex-row justify-between gap-3">
      <p class="font-body text-xs leading-relaxed text-tinta-3 max-w-2xl">
        Información divulgativa. Cifras tomadas de FEDEGAN, ICA, DANE, Asocebú y de la literatura científica citada en cada sección.
      </p>
      <p class="font-body text-xs text-tinta-3">© {anio} RB Ganadería</p>
    </div>
  </div>
</footer>
