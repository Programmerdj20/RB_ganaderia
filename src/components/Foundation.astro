---
// Sección: La raza y su escala — contadores animados con cifras del sector ganadero colombiano
const metricas = [
  // Fuente: FEDEGAN, inventario bovino y bufalino (29.034.525 bovinos), 2025
  { valor: 29034525, sufijo: '', etiqueta: 'Bovinos en Colombia',    descripcion: 'Inventario nacional registrado por FEDEGAN' },
  // Fuente: FEDEGAN, Oficina de Estudios Económicos, 2025
  { valor: 1099273,  sufijo: '', etiqueta: 'Empleos Directos',       descripcion: 'Generados por la ganadería bovina y bufalina' },
  // Fuente: DANE, procesado por FEDEGAN, 2025
  { valor: 227429,   sufijo: '', etiqueta: 'Bovinos Exportados',     descripcion: 'Animales en pie enviados al exterior en 2025' },
];
const fmt = (n: number) => n.toLocaleString('es-CO');
---

<section
  id="fundacion"
  class="relative py-20 md:py-28 px-5 sm:px-6 bg-superficie-1 border-t border-linea-acento"
  aria-labelledby="fundacion-titulo"
>
  <div class="max-w-6xl mx-auto">

    <!-- Encabezado editorial -->
    <div class="grid md:grid-cols-12 gap-10 md:gap-16 items-start mb-16 md:mb-24">
      <div class="md:col-span-7" data-reveal>
        <h2 id="fundacion-titulo" class="font-serif text-4xl md:text-5xl leading-[1.15] text-tinta text-balance">
          El Brahman Rojo, una raza al servicio del campo colombiano
        </h2>
      </div>
      <div class="md:col-span-5 md:pt-10" data-reveal style="--d: 0.15s;">
        <p class="font-body text-lg leading-relaxed mb-6 text-tinta-2">
          Colombia tiene cerca de
          <strong class="font-semibold text-tinta">29 millones de bovinos</strong>
          y la ganadería genera más de
          <strong class="font-semibold text-tinta">un millón de empleos directos</strong>.
          En ese hato, el Brahman es la base del ganado cebú del país.
        </p>
        <p class="font-body text-lg leading-relaxed text-tinta-2">
          Su adaptación al calor, su habilidad materna y su resistencia explican por qué el Brahman Rojo
          es una de las razas que mejor se desempeña en el trópico bajo colombiano.
        </p>
      </div>
    </div>

    <!-- Contadores: el HTML trae el valor final; el script anima desde 0 solo si hay movimiento -->
    <ul class="metricas grid grid-cols-1 md:grid-cols-3 border border-linea-acento" aria-label="Cifras de la ganadería colombiana">
      {metricas.map((m, i) => (
        <li class="metric-card px-6 py-12 sm:px-10 sm:py-16 text-center" data-reveal style={`--d: ${i * 0.12}s;`}>
          <p
            class="font-serif tabular-nums tracking-tight text-oro mb-5"
            style="font-size: clamp(3.5rem, 8vw, 6rem); line-height: 1;"
            data-counter
            data-target={m.valor}
            data-suffix={m.sufijo}
          >
            {fmt(m.valor)}{m.sufijo}
          </p>
          <p class="font-sans font-medium text-xs uppercase tracking-[0.2em] mb-2 text-tinta">
            {m.etiqueta}
          </p>
          <p class="font-body text-sm leading-snug text-tinta-3">
            {m.descripcion}
          </p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* Divisores del grid de métricas — mobile: horizontal, desktop: vertical */
  .metric-card { border-bottom: 1px solid rgba(139, 26, 26, 0.35); }
  .metric-card:last-child { border-bottom: none; }
  @media (min-width: 768px) {
    .metric-card { border-bottom: none; border-right: 1px solid rgba(139, 26, 26, 0.35); }
    .metric-card:last-child { border-right: none; }
  }
</style>

<script>
  const counters = document.querySelectorAll<HTMLElement>('[data-counter]');
  const motionOk = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (motionOk && 'IntersectionObserver' in window) {
    const format = (n: number) => n.toLocaleString('es-CO');

    const animate = (el: HTMLElement) => {
      const target = parseInt(el.dataset.target ?? '0', 10);
      const suffix = el.dataset.suffix ?? '';
      const duration = 2000;
      const start = performance.now();

      const step = (now: number) => {
        const progress = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        el.textContent = format(Math.floor(eased * target)) + suffix;
        if (progress < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        animate(entry.target as HTMLElement);
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.5 });

    counters.forEach((el) => {
      el.textContent = '0' + (el.dataset.suffix ?? '');
      observer.observe(el);
    });
  }
</script>
