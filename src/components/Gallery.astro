---
// Sección: El hato — dos hileras de fotos en movimiento contrario, con pausa y zoom al pasar el cursor,
// y visor a pantalla completa. Las fotos viven en src/assets/hato (hato-NN, NN = orden de entrega).
import { Image, getImage } from 'astro:assets';

const archivos = import.meta.glob<{ default: ImageMetadata }>('../assets/hato/*.webp', { eager: true });
const foto = (n: number) => archivos[`../assets/hato/hato-${String(n).padStart(2, '0')}.webp`].default;

// Pie y descripción por foto. Orden de cada hilera: se alternan pradera/corral y horizontal/vertical.
const info: Record<number, { pie: string; alt: string }> = {
  3:  { pie: 'Hato en la pradera',        alt: 'Hato de ganado rojo de frente en la pradera bajo un cielo azul' },
  4:  { pie: 'Ganado en el potrero',      alt: 'Reses caminando por un potrero verde, vistas desde lejos' },
  5:  { pie: 'Hato en el corral',         alt: 'Hato alineado junto a la cerca del corral bajo un cielo nublado' },
  6:  { pie: 'Corral con portón amarillo', alt: 'Hato reunido en el corral junto a un portón amarillo' },
  7:  { pie: 'Reses en la pradera',       alt: 'Grupo de reses rojas mirando a la cámara en la pradera' },
  8:  { pie: 'Corral, vista lateral',     alt: 'Reses en el corral con la cerca oscura y el campo abierto al fondo' },
  9:  { pie: 'Hato reunido',              alt: 'Hato reunido en el corral con piso de adoquín' },
  10: { pie: 'Hato en el corral',         alt: 'Reses de pie en el corral bajo un cielo cubierto' },
  11: { pie: 'Corral y colinas',          alt: 'Hato en el corral con colinas verdes en el horizonte' },
  12: { pie: 'Manga de manejo',           alt: 'Ganado dentro de la manga de manejo con portón amarillo' },
  13: { pie: 'Corral con vista al valle', alt: 'Hato en el corral con un valle verde y árboles al fondo' },
  14: { pie: 'Reses en el corral',        alt: 'Reses rojas en el corral con la cerca y el campo detrás' },
  15: { pie: 'Corral y praderas',         alt: 'Hato apretado en el corral frente a praderas extensas' },
  16: { pie: 'Hato frente al valle',      alt: 'Hato mirando al frente en el corral con el valle detrás' },
  17: { pie: 'Panorámica del corral',     alt: 'Vista amplia del corral vacío con el hato al fondo' },
  18: { pie: 'Ganado en movimiento',      alt: 'Reses caminando dentro del corral' },
  19: { pie: 'Crías en el corral',        alt: 'Crías y reses reunidas en el corral con colinas detrás' },
  20: { pie: 'Hato en el corral',         alt: 'Reses en el corral con el campo abierto al fondo' },
  21: { pie: 'Hato al frente',            alt: 'Hato mirando a la cámara en el corral con praderas detrás' },
};

const hilera1 = [3, 8, 12, 13, 7, 15, 18, 10, 4, 21];
const hilera2 = [6, 17, 14, 20, 9, 5, 16, 19, 11];
const hileras = [
  { nombre: 'Primera hilera, se mueve hacia la izquierda', ids: hilera1, clase: 'hacia-izq', duracion: '90s' },
  { nombre: 'Segunda hilera, se mueve hacia la derecha',   ids: hilera2, clase: 'hacia-der', duracion: '110s' },
];

// Orden del visor: primera hilera y luego la segunda
const orden = [...hilera1, ...hilera2];
const indice = new Map(orden.map((n, i) => [n, i]));

const ampliadas = await Promise.all(orden.map((n) => getImage({ src: foto(n), width: 1600, format: 'webp' })));
const datos = orden.map((n, i) => ({ src: ampliadas[i].src, pie: info[n].pie, alt: info[n].alt }));
---

<section
  id="hato"
  class="galeria-seccion relative py-20 md:py-32 bg-superficie-1 border-t border-linea-acento overflow-hidden"
  aria-labelledby="hato-titulo"
>
  <div class="max-w-6xl mx-auto px-5 sm:px-6">
    <div class="grid md:grid-cols-12 gap-6 md:gap-16 mb-12 md:mb-16" data-reveal>
      <h2 id="hato-titulo" class="md:col-span-7 font-serif text-3xl sm:text-4xl md:text-5xl leading-[1.15] text-tinta text-balance">
        Un recorrido por el hato
      </h2>
      <div class="md:col-span-5 md:pt-3">
        <p class="font-body text-lg leading-relaxed text-tinta-2" style="text-wrap: pretty;">
          Pradera, corral y manga: el Brahman Rojo en su día a día.
        </p>
        <p class="ayuda mt-4 font-body text-sm text-tinta-3">
          Pasa el cursor para detener y acercar. Haz clic para ver la foto completa.
        </p>
        <button type="button" id="pausa" class="pausa mt-4" aria-pressed="false">
          <svg class="pausa-icono" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <rect class="p1" x="6" y="5" width="4" height="14" rx="1" />
            <rect class="p2" x="14" y="5" width="4" height="14" rx="1" />
          </svg>
          <span class="pausa-texto">Pausar el movimiento</span>
        </button>
      </div>
    </div>
  </div>

  <div class="hileras" data-reveal style="--d: 0.1s;">
    {hileras.map((h) => (
      <div class="hilera" role="group" aria-label={h.nombre}>
        <div class={`pista ${h.clase}`} style={`--dur: ${h.duracion};`}>
          {[0, 1].map((copia) => (
            <ul class:list={['tira', { copia: copia === 1 }]} aria-hidden={copia === 1 ? 'true' : undefined}>
              {h.ids.map((n) => (
                <li class="celda">
                  <button
                    type="button"
                    class="foto"
                    data-index={indice.get(n)}
                    aria-label={`Ampliar foto: ${info[n].pie}`}
                    tabindex={copia === 1 ? -1 : undefined}
                  >
                    <Image
                      src={foto(n)}
                      alt={copia === 1 ? '' : info[n].alt}
                      widths={[360, 540, 720]}
                      sizes="(min-width: 768px) 360px, 250px"
                      loading="lazy"
                      class="foto-img"
                    />
                    <span class="foto-pie" aria-hidden="true">{info[n].pie}</span>
                  </button>
                </li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    ))}
  </div>

  <!-- Visor: <dialog> nativo; Esc cierra, flechas navegan -->
  <dialog id="visor" class="visor" aria-label="Visor de fotografías del hato">
    <figure class="visor-figura">
      <img id="visor-img" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="" />
      <figcaption id="visor-pie"></figcaption>
    </figure>
    <button type="button" class="visor-btn visor-cerrar" id="visor-cerrar" aria-label="Cerrar visor">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
    <button type="button" class="visor-btn visor-prev" id="visor-prev" aria-label="Foto anterior">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 5l-7 7 7 7"/></svg>
    </button>
    <button type="button" class="visor-btn visor-next" id="visor-next" aria-label="Foto siguiente">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
    </button>
  </dialog>

  <script type="application/json" id="galeria-datos" set:html={JSON.stringify(datos)} />
</section>

<style>
  .hileras { display: flex; flex-direction: column; gap: 0.5rem; }

  /* Bordes difuminados: las fotos entran y salen sin corte */
  .hilera {
    --alto: 190px;
    overflow-x: clip;
    padding-block: 0.6rem;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
            mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
  }
  @media (min-width: 768px) { .hilera { --alto: 280px; } }

  /* Dos copias de la tira: al desplazar -50 % el bucle es continuo. Las fotos llevan margen, no gap, para que el 50 % sea exacto */
  .pista { display: flex; width: max-content; animation: desplazar var(--dur) linear infinite; will-change: transform; }
  .hacia-izq { --desde: 0%;    --hasta: -50%; }
  .hacia-der { --desde: -50%;  --hasta: 0%; }
  @keyframes desplazar {
    from { transform: translateX(var(--desde)); }
    to   { transform: translateX(var(--hasta)); }
  }

  .tira { display: flex; margin: 0; padding: 0; list-style: none; }
  .celda { margin-right: 0.75rem; }

  .foto {
    position: relative;
    display: block;
    height: var(--alto);
    padding: 0;
    overflow: hidden;
    border: 1px solid rgba(139, 26, 26, 0.35);
    background: #0B0A09;
    cursor: zoom-in;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.5s ease, filter 0.5s ease, box-shadow 0.6s ease;
  }
  .foto :global(.foto-img) {
    display: block;
    height: 100%;
    width: auto;
    transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .foto-pie {
    position: absolute;
    inset: auto 0 0 0;
    padding: 2.2rem 0.9rem 0.7rem;
    text-align: left;
    font: 500 0.75rem/1.3 'Poppins', sans-serif;
    letter-spacing: 0.06em;
    color: #F0EBE1;
    background: linear-gradient(to top, rgba(11, 10, 9, 0.88), transparent);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.4s ease, transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Cursor sobre una hilera: se detiene, la foto señalada se acerca y las demás bajan de tono */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .hilera:hover .pista, .hilera:focus-within .pista { animation-play-state: paused; }
    .hilera:hover .foto:not(:hover) { opacity: 0.5; filter: saturate(0.65); }
    .foto:hover, .foto:focus-visible { transform: scale(1.05); z-index: 2; box-shadow: 0 14px 40px rgba(0, 0, 0, 0.55); }
    .foto:hover :global(.foto-img), .foto:focus-visible :global(.foto-img) { transform: scale(1.1); }
    .foto:hover .foto-pie, .foto:focus-visible .foto-pie { opacity: 1; transform: none; }
  }

  /* Pausa manual (WCAG 2.2.2) y pausa cuando la sección sale de pantalla */
  .galeria-seccion.pausado .pista, .galeria-seccion.fuera .pista { animation-play-state: paused; }

  .pausa {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    padding: 0 1rem;
    background: transparent;
    border: 1px solid rgba(201, 150, 58, 0.4);
    border-radius: 999px;
    color: #E0B86A;
    font: 500 0.75rem/1 'Poppins', sans-serif;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: background 0.25s ease, border-color 0.25s ease;
  }
  .pausa:hover { background: rgba(201, 150, 58, 0.1); border-color: #E0B86A; }
  .pausa-icono { width: 14px; height: 14px; }
  .pausa[aria-pressed='true'] .p1 { d: path('M7 5 L19 12 L7 19 Z'); }
  .pausa[aria-pressed='true'] .p2 { display: none; }

  /* Sin cursor (táctil) o con movimiento reducido: hileras desplazables a mano, sin animación ni copia */
  @media (hover: none), (prefers-reduced-motion: reduce) {
    .hilera { overflow-x: auto; scroll-snap-type: x proximity; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
    .hilera::-webkit-scrollbar { display: none; }
    .pista { animation: none; }
    .copia, .pausa { display: none; }
    .celda { scroll-snap-align: center; }
    .foto-pie { opacity: 1; transform: none; }
  }
  @media (hover: hover) { .ayuda { display: block; } }
  @media (hover: none) { .ayuda { display: none; } }

  /* ── Visor ── */
  .visor {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100svh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: none;
    background: rgba(11, 10, 9, 0.96);
    color: #F0EBE1;
  }
  .visor:not([open]) { display: none; }
  .visor::backdrop { background: rgba(11, 10, 9, 0.9); }
  .visor-figura {
    margin: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 4.5rem 1rem 1.5rem;
    gap: 1rem;
  }
  .visor-figura img {
    max-width: 100%;
    max-height: calc(100svh - 10rem);
    object-fit: contain;
    border: 1px solid rgba(139, 26, 26, 0.35);
  }
  .visor-figura figcaption {
    font: 500 0.8rem/1.4 'Poppins', sans-serif;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #C2BCB0;
  }
  .visor-btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    background: rgba(24, 23, 21, 0.85);
    border: 1px solid rgba(201, 150, 58, 0.35);
    border-radius: 999px;
    color: #E0B86A;
    cursor: pointer;
    transition: background 0.25s ease, border-color 0.25s ease;
  }
  .visor-btn:hover { background: #1F1D1A; border-color: #E0B86A; }
  .visor-btn svg { width: 22px; height: 22px; }
  .visor-cerrar { top: 1rem; right: 1rem; }
  .visor-prev { left: 1rem; top: 50%; transform: translateY(-50%); }
  .visor-next { right: 1rem; top: 50%; transform: translateY(-50%); }
  @media (max-width: 640px) {
    .visor-prev, .visor-next { top: auto; bottom: 1.25rem; transform: none; }
    .visor-prev { left: calc(50% - 4rem); }
    .visor-next { right: calc(50% - 4rem); }
  }
</style>

<script>
  type Foto = { src: string; pie: string; alt: string };

  const seccion = document.getElementById('hato') as HTMLElement;
  const datos: Foto[] = JSON.parse(document.getElementById('galeria-datos')?.textContent ?? '[]');
  const visor = document.getElementById('visor') as HTMLDialogElement;
  const img = document.getElementById('visor-img') as HTMLImageElement;
  const pie = document.getElementById('visor-pie') as HTMLElement;

  let actual = 0;
  let origen: HTMLElement | null = null;

  const mostrar = (i: number) => {
    actual = (i + datos.length) % datos.length;
    img.src = datos[actual].src;
    img.alt = datos[actual].alt;
    pie.textContent = `${datos[actual].pie} · ${actual + 1} / ${datos.length}`;
  };

  // Las dos copias de cada tira abren la misma foto
  seccion.querySelectorAll<HTMLButtonElement>('.foto').forEach((btn) => {
    btn.addEventListener('click', () => {
      origen = btn;
      mostrar(Number(btn.dataset.index));
      visor.showModal();
    });
  });

  document.getElementById('visor-cerrar')?.addEventListener('click', () => visor.close());
  document.getElementById('visor-prev')?.addEventListener('click', () => mostrar(actual - 1));
  document.getElementById('visor-next')?.addEventListener('click', () => mostrar(actual + 1));

  // Clic sobre el fondo (fuera de la foto y los botones) cierra
  visor.addEventListener('click', (e) => {
    if (e.target === visor || (e.target as HTMLElement).tagName === 'FIGURE') visor.close();
  });

  visor.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') mostrar(actual - 1);
    if (e.key === 'ArrowRight') mostrar(actual + 1);
  });

  // Al cerrar, el foco vuelve a la copia visible de la foto (la copia oculta no recibe foco)
  visor.addEventListener('close', () => {
    const i = origen?.dataset.index;
    (seccion.querySelector<HTMLElement>(`.tira:not(.copia) .foto[data-index="${i}"]`) ?? origen)?.focus({ preventScroll: true });
  });

  // Botón de pausa manual
  const pausa = document.getElementById('pausa') as HTMLButtonElement;
  const texto = pausa.querySelector('.pausa-texto') as HTMLElement;
  pausa.addEventListener('click', () => {
    const on = seccion.classList.toggle('pausado');
    pausa.setAttribute('aria-pressed', String(on));
    texto.textContent = on ? 'Reanudar el movimiento' : 'Pausar el movimiento';
  });

  // Fuera de pantalla no se anima
  if ('IntersectionObserver' in window) {
    new IntersectionObserver(([e]) => seccion.classList.toggle('fuera', !e.isIntersecting)).observe(seccion);
  }
</script>
