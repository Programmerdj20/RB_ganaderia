---
// Sección: Exportación — destinos del ganado en pie, carne y ruta sanitaria.
// Fuentes de cifras: FEDEGAN con datos del DANE (vía Portafolio, El Universal, 2025); consumo per cápita: FEDEGAN 2025.
// Ruta sanitaria: Resolución ICA 97977 de 2021 y comunicados del ICA sobre embarques a Líbano.
const destinos = [
  // Primer semestre de 2025: cabezas y valor en millones de US$
  { nombre: 'Egipto',        cabezas: 47372, usd: '35,6' },
  { nombre: 'Arabia Saudita',cabezas: 43541, usd: '31,5' },
  { nombre: 'Irak',          cabezas: 40933, usd: '31,7' },
  { nombre: 'Jordania',      cabezas: 3046,  usd: '2,3'  },
];
const maxCabezas = destinos[0].cabezas;
const fmt = (n: number) => n.toLocaleString('es-CO');

const ruta = [
  { titulo: 'Finca certificada',        texto: 'El ICA certifica los predios exportadores: asistencia de un médico veterinario con plan sanitario, área de aislamiento y trazabilidad oficial obligatoria.' },
  { titulo: 'Zona sanitaria reconocida', texto: 'El predio debe estar en zona libre de fiebre aftosa, con o sin vacunación, reconocida por la OMSA. En el ciclo I de 2025 se vacunó el 99 % del hato.' },
  { titulo: 'Cuarentena supervisada',    texto: 'Los animales cumplen una cuarentena bajo control del ICA; en los embarques a Líbano fueron 20 días en las fincas proveedoras.' },
  { titulo: 'Protocolo del destino',     texto: 'Colombia tiene protocolos para exportar ganado en pie a Jordania, Líbano, Arabia Saudita, Egipto e Irak. Cada país fija sus propias condiciones.' },
];
---

<section
  id="calidad"
  class="relative py-20 md:py-32 px-5 sm:px-6 bg-superficie-2 border-t border-linea-acento"
  aria-labelledby="calidad-titulo"
>
  <div class="max-w-6xl mx-auto">

    <div class="grid md:grid-cols-12 gap-6 md:gap-16 mb-16 md:mb-24" data-reveal>
      <h2 id="calidad-titulo" class="md:col-span-7 font-serif text-3xl sm:text-4xl md:text-5xl leading-[1.15] text-tinta text-balance">
        Ganado colombiano con destino al mundo
      </h2>
      <p class="md:col-span-5 md:pt-3 font-body text-lg leading-relaxed text-tinta-2" style="text-wrap: pretty;">
        En 2025 salieron
        <strong class="font-semibold text-tinta">227.429 bovinos vivos</strong>
        por US$ 178 millones y
        <strong class="font-semibold text-tinta">34.939 toneladas de carne y vísceras</strong>
        por US$ 160,9 millones.
      </p>
    </div>

    <div class="grid md:grid-cols-12 gap-14 md:gap-16 items-start">

      <!-- Destinos -->
      <div class="md:col-span-7">
        <div class="grafico" data-reveal>
          <h3 class="font-sans font-semibold text-lg text-tinta mb-1">Destinos del ganado en pie</h3>
          <p class="font-body text-sm text-tinta-3 mb-6">Bovinos enviados en el primer semestre de 2025</p>

          <ul class="m-0 p-0 list-none border-t border-linea">
            {destinos.map((d, i) => (
              <li class="fila border-b border-linea" style={`--d: ${i * 0.12}s;`}>
                <span class="fila-nombre">{d.nombre}</span>
                <span class="fila-cifra">{fmt(d.cabezas)}</span>
                <span class="barra" aria-hidden="true"><span style={`width: ${((d.cabezas / maxCabezas) * 100).toFixed(1)}%;`}></span></span>
                <span class="fila-usd">US$ {d.usd} millones</span>
              </li>
            ))}
          </ul>
        </div>

        <p class="mt-8 font-body text-base leading-relaxed text-tinta-2 max-w-xl" data-reveal style="text-wrap: pretty;">
          En carne, el principal destino de 2025 fue
          <strong class="font-semibold text-tinta">China</strong>: 18.770 toneladas por US$ 91,7 millones.
        </p>
        <p class="mt-6 font-body text-xs leading-relaxed text-tinta-3 max-w-xl">
          Fuente: FEDEGAN con datos del DANE, 2025. Las cifras por destino cubren enero a junio.
        </p>
      </div>

      <!-- Ruta sanitaria -->
      <div class="md:col-span-5" data-reveal style="--d: 0.12s;">
        <h3 class="font-sans font-semibold text-lg text-tinta mb-1">La ruta sanitaria de un animal exportado</h3>
        <p class="font-body text-sm text-tinta-3 mb-8">Lo que exige el ICA antes del embarque</p>

        <ol class="ruta m-0 p-0 list-none">
          {ruta.map((r) => (
            <li class="ruta-paso">
              <h4 class="font-sans font-semibold text-base text-tinta mb-2">{r.titulo}</h4>
              <p class="font-body text-sm leading-relaxed text-tinta-2" style="text-wrap: pretty;">{r.texto}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>

    <!-- Cierre -->
    <figure class="mt-20 md:mt-32 max-w-3xl mx-auto text-center" data-reveal>
      <blockquote class="font-serif text-xl md:text-2xl leading-[1.65] italic text-tinta text-balance">
        En casa, cada colombiano consumió 18,4 kilos de carne de res en 2025. Hacia afuera, el sector ganadero vendió US$ 394,6 millones, el tercer mejor registro de la década.
      </blockquote>
      <div class="mt-8 mx-auto w-10 h-px bg-oro" aria-hidden="true"></div>
    </figure>
  </div>
</section>

<style>
  /* Filas de destino: nombre y cifra arriba, barra proporcional y valor en dólares debajo */
  .fila {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    column-gap: 1rem;
    padding: 1rem 0.25rem 1.1rem;
  }
  .fila-nombre { font: 500 1rem/1.3 'Poppins', sans-serif; color: #F0EBE1; }
  .fila-cifra  { font: 500 1.5rem/1.2 'Playfair Display', Georgia, serif; font-variant-numeric: tabular-nums; color: #E0B86A; }
  .barra {
    grid-column: 1 / -1;
    margin-top: 0.7rem;
    height: 6px;
    background: rgba(240, 235, 225, 0.07);
  }
  .barra > span {
    display: block;
    height: 100%;
    background: #C9963A;
    transform-origin: left;
    transition: transform 1.3s cubic-bezier(0.16, 1, 0.3, 1) var(--d, 0s);
  }
  .fila-usd { grid-column: 1 / -1; margin-top: 0.45rem; font: 400 0.8rem/1.3 'Inter', sans-serif; color: #A09A8E; }

  /* Un solo momento de movimiento: las barras crecen cuando el gráfico se revela */
  :global(html.js:not(.reveal-all)) .grafico:not(.is-visible) .barra > span { transform: scaleX(0); }

  /* Ruta: línea vertical con un punto por paso */
  .ruta { position: relative; padding-left: 1.75rem; border-left: 1px solid rgba(240, 235, 225, 0.14); }
  .ruta-paso { position: relative; padding-bottom: 2rem; }
  .ruta-paso:last-child { padding-bottom: 0; }
  .ruta-paso::before {
    content: '';
    position: absolute;
    left: calc(-1.75rem - 4px);
    top: 0.45rem;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #C9963A;
  }

  @media (prefers-reduced-motion: reduce) {
    .barra > span { transition: none; }
  }
</style>
