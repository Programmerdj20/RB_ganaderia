---
// Sección: Exportación — ganado colombiano en el mundo. Fuente de cifras: DANE, procesado por FEDEGAN (primer semestre 2025)
const mercados = [
  { region: 'Egipto',        descripcion: '47.372 bovinos en pie recibidos en el primer semestre de 2025' },
  { region: 'Arabia Saudita',descripcion: '43.541 bovinos en pie recibidos en el primer semestre de 2025' },
  { region: 'Irak',          descripcion: '40.933 bovinos en pie recibidos en el primer semestre de 2025' },
  { region: 'Colombia',      descripcion: '18,8 kg per cápita de consumo interno proyectado de proteína bovina' },
];
---

<section
  id="calidad"
  class="relative py-20 md:py-28 px-5 sm:px-6 bg-superficie-1 border-t border-linea-acento"
  aria-labelledby="calidad-titulo"
>
  <div class="max-w-6xl mx-auto">

    <div class="grid md:grid-cols-12 gap-10 md:gap-16 items-end mb-12 md:mb-20">
      <div class="md:col-span-6" data-reveal>
        <h2 id="calidad-titulo" class="font-serif text-3xl sm:text-4xl md:text-5xl leading-[1.15] text-tinta text-balance">
          Ganado colombiano con destino al mundo
        </h2>
      </div>
      <div class="md:col-span-6" data-reveal style="--d: 0.15s;">
        <p class="font-body text-lg leading-relaxed text-tinta-2" style="text-wrap: pretty;">
          Colombia proyecta un consumo interno de proteína bovina de
          <strong class="font-semibold text-oro">18,8 kilos per cápita</strong>
          y exporta carne y ganado en pie. En 2025 salieron 227.429 bovinos vivos, principalmente hacia Egipto, Irak y Arabia Saudita, con controles sanitarios del ICA y trazabilidad desde el origen.
        </p>
      </div>
    </div>

    <!-- Mercados: filas separadas por filetes, sin tarjetas -->
    <ul class="mercados grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 border border-linea-acento" aria-label="Principales destinos de exportación">
      {mercados.map((m, i) => (
        <li class={`mercado group relative py-8 sm:py-10 px-6 sm:px-8 bg-superficie-0 market-idx-${i}`} data-reveal style={`--d: ${i * 0.1}s;`}>
          <div class="absolute top-0 left-0 right-0 h-px bg-oro opacity-0 group-hover:opacity-100 transition-opacity duration-500" aria-hidden="true"></div>
          <div class="mb-6 w-6 h-px bg-acento transition-all duration-500 group-hover:w-10 group-hover:bg-oro" aria-hidden="true"></div>
          <h3 class="font-sans font-semibold text-xl mb-3 text-tinta">
            {m.region}
          </h3>
          <p class="font-body text-sm leading-relaxed text-tinta-3">
            {m.descripcion}
          </p>
        </li>
      ))}
    </ul>

    <!-- Cita institucional -->
    <figure class="mt-12 sm:mt-20 max-w-3xl mx-auto text-center" data-reveal>
      <blockquote class="font-serif text-xl md:text-2xl leading-[1.65] italic text-tinta text-balance">
        Cada animal que sale del país lleva su historia: origen, vacunación y movimientos quedan
        registrados en el sistema nacional de trazabilidad.
      </blockquote>
      <div class="mt-8 mx-auto w-10 h-px bg-oro" aria-hidden="true"></div>
    </figure>
  </div>
</section>

<style>
  /* Divisores del grid — 1 col: horizontal · 2 col (sm) · 4 col (lg) */
  .mercado { border-bottom: 1px solid rgba(139, 26, 26, 0.35); }
  .mercado:last-child { border-bottom: none; }

  @media (min-width: 640px) {
    .mercado { border-bottom: none; }
    .market-idx-0, .market-idx-2 { border-right: 1px solid rgba(139, 26, 26, 0.35); }
    .market-idx-0, .market-idx-1 { border-bottom: 1px solid rgba(139, 26, 26, 0.35); }
  }

  @media (min-width: 1024px) {
    .mercado { border-bottom: none; border-right: 1px solid rgba(139, 26, 26, 0.35); }
    .market-idx-3 { border-right: none; }
  }
</style>
