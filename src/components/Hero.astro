---
// Hero: cabecera inmersiva — foto a pantalla completa
import { Image } from 'astro:assets';
import heroFoto from '../assets/galeria/hero-hato-frente.jpg';
---

<section
  id="inicio"
  class="relative min-h-[100svh] w-full overflow-hidden flex items-center justify-center bg-superficie-0"
  aria-label="Cabecera principal"
>
  <!-- Foto de fondo -->
  <Image
    src={heroFoto}
    alt=""
    widths={[768, 1280, 1920]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 w-full h-full object-cover animate-hero-drift"
    aria-hidden="true"
  />

  <!-- Overlay cálido: protege la lectura del titular y la barra de navegación -->
  <div
    class="absolute inset-0"
    style="background: linear-gradient(to bottom, rgba(11,10,9,0.78) 0%, rgba(11,10,9,0.5) 38%, rgba(11,10,9,0.62) 68%, #121110 100%);"
    aria-hidden="true"
  ></div>

  <!-- Línea carmesí superior — firma del logo -->
  <div
    class="absolute top-0 left-0 right-0 h-px"
    style="background: linear-gradient(to right, transparent, #8B1A1A 30%, #8B1A1A 70%, transparent);"
    aria-hidden="true"
  ></div>

  <!-- Contenido centrado -->
  <div
    class="relative z-10 text-center px-5 sm:px-6 pt-28 pb-24 max-w-4xl mx-auto opacity-0 animate-fade-up"
    style="animation-delay: 0.3s;"
  >
    <h1 class="font-serif leading-[1.1] mb-6 sm:mb-8 text-tinta text-balance" style="font-size: clamp(2.1rem, 6.5vw, 5rem); text-shadow: 0 2px 30px rgba(0,0,0,0.45);">
      Brahman Rojo:<br/>
      <em class="italic text-tinta-2">la raza hecha para<br class="sm:hidden"/>&#8202;el trópico colombiano</em>
    </h1>

    <div class="mx-auto mb-6 sm:mb-8 w-14 h-px bg-oro/70" aria-hidden="true"></div>

    <p class="font-body text-base sm:text-lg md:text-xl font-light max-w-2xl mx-auto leading-relaxed text-tinta" style="text-wrap: pretty;">
      Adaptación, genética y manejo de una raza que sostiene empleo, territorio y exportaciones en el campo colombiano.
    </p>
  </div>

  <!-- Flecha de scroll — solo desktop -->
  <div class="hidden sm:block absolute bottom-10 left-1/2 -translate-x-1/2 z-10 animate-scroll-arrow">
    <a href="#fundacion" class="flex flex-col items-center gap-3" aria-label="Ir a la siguiente sección">
      <span
        class="block w-px h-10"
        style="background: linear-gradient(to bottom, transparent, rgba(224,184,106,0.8));"
      ></span>
      <svg
        class="w-4 h-4 text-oro-claro"
        fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
      </svg>
    </a>
  </div>
</section>
