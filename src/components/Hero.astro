---
// Hero: cabecera inmersiva — dos fotos a pantalla completa en fundido cruzado con zoom lento.
// Las fotos son de 1024×768: si el cliente aporta originales de 1920 px o más, reemplazar los archivos sin tocar el código.
---

<section
  id="inicio"
  class="hero relative min-h-[100svh] w-full overflow-hidden flex items-end bg-superficie-0"
  aria-label="Cabecera principal"
>
  <!-- Fotos de fondo: cada una dura ~10 s; la segunda entra mientras la primera sale -->
  <div class="absolute inset-0" aria-hidden="true">
    <img
      src="/galeria/Banner_1.webp"
      alt=""
      width="1024"
      height="768"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="foto foto-a"
    />
    <img
      src="/galeria/Banner_2.webp"
      alt=""
      width="1024"
      height="768"
      loading="eager"
      fetchpriority="low"
      decoding="async"
      class="foto foto-b"
    />
  </div>

  <!-- Velo mínimo + degradado inferior: el texto se apoya en la parte baja y la foto queda limpia arriba -->
  <div
    class="absolute inset-0"
    style="background:
      linear-gradient(to top, #121110 0%, rgba(18,17,16,0.92) 24%, rgba(18,17,16,0.68) 48%, rgba(18,17,16,0) 76%),
      linear-gradient(to bottom, rgba(11,10,9,0.35) 0%, rgba(11,10,9,0) 24%),
      rgba(11,10,9,0.08);"
    aria-hidden="true"
  ></div>

  <!-- Línea carmesí superior — firma del logo -->
  <div
    class="absolute top-0 left-0 right-0 h-px"
    style="background: linear-gradient(to right, transparent, #8B1A1A 30%, #8B1A1A 70%, transparent);"
    aria-hidden="true"
  ></div>

  <!-- Contenido anclado abajo a la izquierda -->
  <div class="relative z-10 w-full max-w-6xl mx-auto px-5 sm:px-6 pt-40 pb-16 sm:pb-20 md:pb-24">
    <h1 class="font-serif leading-[1.08] mb-6 sm:mb-8 text-tinta max-w-3xl" style="font-size: clamp(2.3rem, 6vw, 5.2rem); text-shadow: 0 2px 28px rgba(0,0,0,0.5);">
      <span class="rev block" style="--d: 0.2s;">Brahman Rojo:</span>
      <em class="rev block italic text-tinta" style="--d: 0.45s;">la raza hecha para el trópico colombiano</em>
    </h1>

    <div class="regla mb-6 sm:mb-8 h-px w-16 bg-oro" aria-hidden="true"></div>

    <p class="rev font-body text-base sm:text-lg md:text-xl font-light max-w-xl leading-relaxed text-tinta" style="--d: 0.95s; text-wrap: pretty; text-shadow: 0 1px 16px rgba(0,0,0,0.5);">
      Adaptación, genética y manejo de una raza que sostiene empleo, territorio y exportaciones en el campo colombiano.
    </p>
  </div>

  <!-- Pausa del movimiento (WCAG 2.2.2), indicador de foto activa y flecha de scroll.
       En móvil solo queda el botón de pausa; indicador y flecha son de escritorio. -->
  <div class="absolute bottom-3 right-4 sm:bottom-16 md:bottom-24 sm:right-6 md:right-[max(1.5rem,calc((100vw-72rem)/2+1.5rem))] z-10 flex flex-col items-end sm:items-center gap-6 rev" style="--d: 1.4s;">
    <div class="flex items-center gap-4">
      <div class="hidden sm:flex gap-2" aria-hidden="true">
        <span class="pista"><span class="llenado llenado-a"></span></span>
        <span class="pista"><span class="llenado llenado-b"></span></span>
      </div>
      <button type="button" id="hero-pausa" class="hero-pausa" aria-pressed="false" aria-label="Pausar el movimiento de las fotos">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path class="i-pausa" d="M9 6v12M15 6v12" />
          <path class="i-play" d="M8 5.5v13l10.5-6.5z" />
        </svg>
      </button>
    </div>
    <a href="#fundacion" class="hidden sm:flex flex-col items-center gap-3 animate-scroll-arrow p-3.5 -m-3.5" aria-label="Ir a la siguiente sección">
      <span
        class="block w-px h-10"
        style="background: linear-gradient(to bottom, transparent, rgba(224,184,106,0.8));"
      ></span>
      <svg
        class="w-4 h-4 text-oro-claro"
        fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
      </svg>
    </a>
  </div>
</section>

<style>
  /* Ciclo de 20 s: cada foto se ve ~10 s y el fundido dura 1,6 s.
     La foto A arranca con delay negativo para estar visible desde el primer fotograma. */
  .foto {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    opacity: 0;
    will-change: opacity, transform;
    animation: ciclo 20s linear infinite;
  }
  .foto-a { transform-origin: 62% 42%; animation-delay: -1.6s; }
  .foto-b { transform-origin: 38% 55%; animation-delay: 8.4s; }

  @keyframes ciclo {
    0%   { opacity: 0; transform: scale(1.02); }
    8%   { opacity: 1; }
    50%  { opacity: 1; }
    58%  { opacity: 0; transform: scale(1.1); }
    100% { opacity: 0; transform: scale(1.1); }
  }

  /* Entrada del texto: sube y se enfoca, escalonada */
  .rev { animation: revelar 1.1s cubic-bezier(0.16, 1, 0.3, 1) var(--d, 0s) backwards; }
  @keyframes revelar {
    from { opacity: 0; transform: translateY(22px); filter: blur(8px); }
  }
  .regla { transform-origin: left; animation: trazar 1s cubic-bezier(0.16, 1, 0.3, 1) 0.8s backwards; }
  @keyframes trazar { from { transform: scaleX(0); } }

  /* Indicador: una pista por foto, se llena mientras esa foto está activa */
  .pista { display: block; width: 1.75rem; height: 2px; background: rgba(240, 235, 225, 0.25); overflow: hidden; }
  .llenado {
    display: block;
    height: 100%;
    background: #E0B86A;
    transform-origin: left;
    transform: scaleX(0);
    animation: llenar 20s linear infinite;
  }
  .llenado-b { animation-delay: 8.4s; }
  @keyframes llenar {
    0%    { transform: scaleX(0); }
    42%   { transform: scaleX(1); }
    50%   { transform: scaleX(1); }
    50.1% { transform: scaleX(0); }
    100%  { transform: scaleX(0); }
  }

  /* Fuera de pantalla o con la pausa del visitante se detiene todo el movimiento */
  .hero.fuera :global(*),
  .hero.pausado :global(*) { animation-play-state: paused !important; }

  .hero-pausa {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    background: rgba(11, 10, 9, 0.55);
    border: 1px solid rgba(224, 184, 106, 0.45);
    border-radius: 999px;
    color: #E0B86A;
    cursor: pointer;
    transition: background 0.25s ease, border-color 0.25s ease;
  }
  .hero-pausa:hover { background: rgba(11, 10, 9, 0.8); border-color: #E0B86A; }
  .hero-pausa svg { width: 18px; height: 18px; }
  .hero-pausa .i-play { display: none; fill: currentColor; }
  .hero-pausa[aria-pressed='true'] .i-pausa { display: none; }
  .hero-pausa[aria-pressed='true'] .i-play { display: block; }

  /* Movimiento reducido: solo la primera foto, quieta; el texto aparece con un fundido simple */
  @media (prefers-reduced-motion: reduce) {
    .hero-pausa { display: none; }
    .foto { animation: none; }
    .foto-a { opacity: 1; transform: none; }
    .foto-b, .llenado, .pista { display: none; }
    .rev { animation: aparecer 0.6s ease-out var(--d, 0s) backwards; }
    .regla { animation: none; }
    @keyframes aparecer { from { opacity: 0; } }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('#inicio');
  if (hero && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => {
      hero.classList.toggle('fuera', !entry.isIntersecting);
    }).observe(hero);
  }

  // Pausa del visitante: congela el fundido cruzado, el zoom y el indicador
  const pausa = document.getElementById('hero-pausa');
  pausa?.addEventListener('click', () => {
    const on = hero?.classList.toggle('pausado') ?? false;
    pausa.setAttribute('aria-pressed', String(on));
  });
</script>
