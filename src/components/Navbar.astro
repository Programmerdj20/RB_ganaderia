---
// Navbar corporativo — layout grid 3 columnas: logo | menú centrado | CTA
const navLinks = [
  { href: '#inicio',     label: 'Inicio' },
  { href: '#fundacion',  label: 'Legado' },
  { href: '#excelencia', label: 'Excelencia' },
  { href: '#hacienda',   label: 'Hacienda' },
  { href: '#impacto',    label: 'Territorio' },
  { href: '#calidad',    label: 'Calidad Global' },
];
---

<header id="navbar">
  <!-- Línea carmesí superior — eco del hero -->
  <div class="nav-crimson-line" aria-hidden="true"></div>

  <nav class="nav-inner" aria-label="Menú principal">

    <!-- Col 1: Logo -->
    <a href="#inicio" class="nav-logo" aria-label="RB Ganadería — inicio">
      <img
        src="/logo.webp"
        alt="RB Ganadería"
        width="218"
        height="82"
        loading="eager"
        decoding="async"
      />
    </a>

    <!-- Col 2: Links de navegación — centrados por grid -->
    <ul class="nav-links">
      {navLinks.map((link) => (
        <li>
          <a href={link.href} class="nav-link" data-nav-link>
            {link.label}
            <span class="nav-link-line" aria-hidden="true"></span>
          </a>
        </li>
      ))}
    </ul>

    <!-- Col 3: CTA desktop + Hamburger mobile -->
    <div class="nav-end">
      <a href="#contacto" class="nav-cta">Contacto</a>
      <button
        class="nav-hamburger"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Abrir menú"
        id="hamburger-btn"
        type="button"
      >
        <span class="ham-bar"></span>
        <span class="ham-bar"></span>
        <span class="ham-bar"></span>
      </button>
    </div>

  </nav>

  <!-- Menú móvil: desplegable de navegación; cerrado queda fuera del foco (inert) -->
  <div id="mobile-menu" class="mobile-menu" inert>
    <div class="mobile-menu-inner">
      <ul>
        {navLinks.map((link) => (
          <li>
            <a href={link.href} class="mobile-link" data-mobile-link>{link.label}</a>
          </li>
        ))}
      </ul>
      <a href="#contacto" class="mobile-cta" data-mobile-link>Contacto</a>
    </div>
  </div>
</header>

<style>
  /* ── Variables ── */
  :root {
    --gold:       #C9963A;
    --gold-lt:    #E0B86A;
    --crimson:    #8B1A1A;
    --logo-bg:    #090909;   /* color exacto del fondo del logo.webp */
    --nav-h:      92px;
  }

  @media (max-width: 1023px) {
    :root { --nav-h: 80px; }
  }

  /* ── Header base: fondo igual al logo para que no haya sticker ── */
  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: var(--logo-bg);
    transition: box-shadow 0.45s ease;
  }

  header.scrolled {
    box-shadow: 0 1px 0 rgba(201, 150, 58, 0.14), 0 4px 40px rgba(0, 0, 0, 0.7);
  }

  /* Línea carmesí */
  .nav-crimson-line {
    height: 2px;
    background: linear-gradient(to right, transparent 0%, var(--crimson) 25%, var(--crimson) 75%, transparent 100%);
    opacity: 0.7;
  }

  /* ── Grid: 3 columnas simétricas ── */
  .nav-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: var(--nav-h);
    padding: 0 clamp(1.25rem, 4vw, 3.5rem);
  }

  /* ── Col 1: Logo ── */
  .nav-logo {
    display: flex;
    align-items: center;
    justify-self: start;
    text-decoration: none;
  }
  .nav-logo img {
    height: 82px;
    width: auto;
    display: block;
  }

  @media (max-width: 1023px) {
    .nav-logo img { height: 74px; }
  }

  /* ── Col 2: Links centrados ── */
  .nav-links {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 1.7vw, 1.75rem);
    list-style: none;
    margin: 0;
    padding: 0;
    justify-self: center;
  }

  .nav-link {
    position: relative;
    font-family: 'Poppins', sans-serif;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #C2BCB0;
    text-decoration: none;
    padding: 0.55rem 0;
    transition: color 0.25s ease;
    white-space: nowrap;
  }
  .nav-link:hover,
  .nav-link.active {
    color: var(--gold-lt);
  }

  /* Línea dorada bajo el link */
  .nav-link-line {
    position: absolute;
    bottom: 0.2rem;
    left: 0;
    right: 100%;
    height: 1px;
    background: linear-gradient(to right, var(--gold), var(--gold-lt));
    transition: right 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .nav-link:hover .nav-link-line,
  .nav-link.active .nav-link-line {
    right: 0;
  }

  /* ── Col 3: CTA + Hamburger ── */
  .nav-end {
    display: flex;
    align-items: center;
    justify-self: end;
  }

  .nav-cta {
    font-family: 'Poppins', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #0a0a0a;
    background: linear-gradient(135deg, var(--gold) 0%, var(--gold-lt) 50%, var(--gold) 100%);
    background-size: 200% 100%;
    padding: 0.8rem 1.6rem;
    border-radius: 4px;
    text-decoration: none;
    transition: background-position 0.4s ease, box-shadow 0.3s ease, transform 0.2s ease;
    box-shadow: 0 2px 14px rgba(201, 150, 58, 0.2);
  }
  .nav-cta:hover {
    background-position: 100% 0;
    box-shadow: 0 4px 22px rgba(201, 150, 58, 0.38);
    transform: translateY(-1px);
  }
  .nav-cta:active { transform: translateY(0); }

  /* ── Hamburger (oculto en desktop) ── */
  .nav-hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 48px;
    height: 48px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 4px;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .ham-bar {
    display: block;
    width: 26px;
    height: 1.5px;
    background: #E8E2D6;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.3s ease,
                background 0.3s ease;
    transform-origin: center;
  }

  .nav-hamburger[aria-expanded="true"] .ham-bar:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
    background: var(--gold);
  }
  .nav-hamburger[aria-expanded="true"] .ham-bar:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  .nav-hamburger[aria-expanded="true"] .ham-bar:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
    background: var(--gold);
  }

  /* ── Menú móvil: la altura se anima con grid-template-rows (sin tocar layout props) ── */
  .mobile-menu {
    display: none;
    grid-template-rows: 0fr;
    visibility: hidden;
    background: #090909;
    border-top: 1px solid rgba(201, 150, 58, 0.12);
    transition: grid-template-rows 0.45s cubic-bezier(0.16, 1, 0.3, 1),
                visibility 0s linear 0.45s;
  }
  .mobile-menu.open {
    grid-template-rows: 1fr;
    visibility: visible;
    transition: grid-template-rows 0.45s cubic-bezier(0.16, 1, 0.3, 1),
                visibility 0s;
  }
  .mobile-menu-inner {
    min-height: 0;
    overflow-y: auto;
    max-height: calc(100svh - var(--nav-h));
    padding: 0 clamp(1.25rem, 5vw, 3.5rem);
    display: flex;
    flex-direction: column;
  }
  .mobile-menu.open .mobile-menu-inner {
    padding-top: 0.75rem;
    padding-bottom: 2rem;
  }
  .mobile-menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .mobile-link {
    display: flex;
    align-items: center;
    font-family: 'Poppins', sans-serif;
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #C2BCB0;
    text-decoration: none;
    padding: 0 0;
    border-bottom: 1px solid rgba(201, 150, 58, 0.1);
    transition: color 0.2s ease;
    min-height: 56px;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  .mobile-link:active { color: var(--gold-lt); }
  @media (hover: hover) {
    .mobile-link:hover { color: var(--gold-lt); }
  }
  .mobile-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 1.75rem;
    font-family: 'Poppins', sans-serif;
    font-size: 0.84rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #0a0a0a;
    background: linear-gradient(135deg, var(--gold), var(--gold-lt));
    padding: 0.85rem 2.5rem;
    border-radius: 4px;
    text-decoration: none;
    align-self: flex-start;
    min-height: 48px;
    touch-action: manipulation;
  }

  /* ── Responsive ── */
  @media (max-width: 1023px) {
    .nav-inner { grid-template-columns: 1fr auto; }
    .nav-links,
    .nav-cta { display: none; }
    .nav-hamburger { display: flex; }
    .mobile-menu { display: grid; }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu,
    .mobile-menu.open { transition: none; }
  }
</style>

<script>
  const header = document.getElementById('navbar') as HTMLElement;
  const btn = document.getElementById('hamburger-btn') as HTMLButtonElement;
  const menu = document.getElementById('mobile-menu') as HTMLElement;

  /* ── Scroll: agrega sombra al bajar ── */
  const updateNavState = () => header.classList.toggle('scrolled', window.scrollY > 40);
  window.addEventListener('scroll', updateNavState, { passive: true });
  updateNavState();

  /* ── Menú móvil: abrir/cerrar con gestión de foco ── */
  const setMenu = (open: boolean, returnFocus = false) => {
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    menu.classList.toggle('open', open);
    menu.toggleAttribute('inert', !open);
    if (open) menu.querySelector<HTMLElement>('[data-mobile-link]')?.focus();
    else if (returnFocus) btn.focus();
  };

  btn.addEventListener('click', () => setMenu(btn.getAttribute('aria-expanded') !== 'true'));

  menu.querySelectorAll('[data-mobile-link]').forEach((link) => {
    link.addEventListener('click', () => setMenu(false));
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') setMenu(false, true);
  });

  /* Al pasar a desktop el menú móvil se cierra */
  window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
    if (e.matches) setMenu(false);
  });

  /* ── Active link según sección visible ── */
  const sections = document.querySelectorAll('section[id]');
  const navLinkEls = document.querySelectorAll('[data-nav-link]');

  const sectionObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const id = entry.target.id;
        navLinkEls.forEach((el) => {
          el.classList.toggle('active', el.getAttribute('href') === `#${id}`);
        });
      });
    },
    { rootMargin: '-40% 0px -40% 0px', threshold: 0 },
  );

  sections.forEach((s) => sectionObserver.observe(s));
</script>
