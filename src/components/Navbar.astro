---
// Navbar — grid: logo a la izquierda | links a la derecha (como el footer) | hamburguesa (móvil)
const navLinks = [
  { href: '#fundacion',  label: 'La raza' },
  { href: '#excelencia', label: 'La ciencia' },
  { href: '#hato',   label: 'El hato' },
  { href: '#impacto',    label: 'Territorio' },
  { href: '#calidad',    label: 'Exportación' },
];
---

<header id="navbar">
  <!-- Línea carmesí superior — eco del hero -->
  <div class="nav-crimson-line" aria-hidden="true"></div>

  <nav class="nav-inner" aria-label="Menú principal">

    <!-- Col 1: Logo -->
    <a href="#inicio" class="nav-logo" aria-label="RB Ganadería — inicio">
      <img
        src="/rb-logo.webp"
        alt="RB Ganadería"
        width="264"
        height="348"
        loading="eager"
        decoding="async"
      />
    </a>

    <!-- Col 2: Links de navegación — centrados por grid -->
    <ul class="nav-links">
      {navLinks.map((link) => (
        <li>
          <a href={link.href} class="nav-link" data-nav-link>
            {link.label}
            <span class="nav-link-line" aria-hidden="true"></span>
          </a>
        </li>
      ))}
    </ul>

    <!-- Col 3: Hamburger mobile -->
    <div class="nav-end">
      <button
        class="nav-hamburger"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Abrir menú"
        id="hamburger-btn"
        type="button"
      >
        <span class="ham-bar"></span>
        <span class="ham-bar"></span>
      </button>
    </div>

  </nav>

  <!-- Menú móvil: panel lateral; cerrado queda fuera del foco (inert) -->
  <div id="menu-backdrop" class="menu-backdrop" aria-hidden="true"></div>
  <div id="mobile-menu" class="mobile-menu" role="dialog" aria-modal="true" aria-label="Menú" inert>
    <ul>
      {navLinks.map((link, i) => (
        <li style={`--i: ${i};`}>
          <a href={link.href} class="mobile-link" data-mobile-link>{link.label}</a>
        </li>
      ))}
    </ul>
    <p class="mobile-firma">Una iniciativa de RB Ganadería</p>
  </div>
</header>

<style>
  /* ── Variables ── */
  :root {
    --nav-h:      100px;
  }

  @media (max-width: 1023px) {
    :root { --nav-h: 84px; }
  }

  /* ── Header base: fondo igual al logo para que no haya sticker ── */
  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: var(--logo-bg);
    transition: box-shadow 0.45s ease, transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Se retira antes de que el footer entre en vista, para no duplicar el menú */
  header.hidden-by-footer {
    transform: translateY(-100%);
    box-shadow: none;
  }

  header.scrolled {
    box-shadow: 0 1px 0 rgba(201, 150, 58, 0.14), 0 4px 40px rgba(0, 0, 0, 0.7);
  }

  /* Línea carmesí */
  .nav-crimson-line {
    height: 2px;
    background: linear-gradient(to right, transparent 0%, var(--acento) 25%, var(--acento) 75%, transparent 100%);
    opacity: 0.7;
  }

  /* ── Grid: 3 columnas simétricas ── */
  .nav-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    height: var(--nav-h);
    /* Mismo contenedor que el footer: max-w-6xl (72rem) + px-5 / sm:px-6 */
    width: 100%;
    max-width: calc(72rem + 3rem);
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  @media (min-width: 640px) {
    .nav-inner { padding: 0 1.5rem; }
  }

  /* ── Col 1: Logo ── */
  .nav-logo {
    display: flex;
    align-items: center;
    justify-self: start;
    text-decoration: none;
  }
  .nav-logo img {
    height: 84px;
    width: auto;
    display: block;
  }

  @media (max-width: 1023px) {
    .nav-logo img { height: 68px; }
  }

  /* ── Col 2: Links centrados ── */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
    justify-self: end;
  }

  .nav-link {
    position: relative;
    font-family: 'Poppins', sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--tinta-2);
    text-decoration: none;
    padding: 0.55rem 0;
    transition: color 0.25s ease;
    white-space: nowrap;
  }
  .nav-link:hover,
  .nav-link.active {
    color: var(--oro-claro);
  }

  /* Línea dorada bajo el link */
  .nav-link-line {
    position: absolute;
    bottom: 0.2rem;
    left: 0;
    right: 100%;
    height: 1px;
    background: linear-gradient(to right, var(--oro), var(--oro-claro));
    transition: right 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .nav-link:hover .nav-link-line,
  .nav-link.active .nav-link-line {
    right: 0;
  }

  /* ── Col 3: Hamburger ── */
  .nav-end {
    display: none;
    align-items: center;
    justify-self: end;
  }

  /* ── Hamburger (oculto en desktop): dos líneas asimétricas que se cruzan en X ── */
  .nav-hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: flex-end;
    gap: 7px;
    width: 48px;
    height: 48px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0 11px;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .ham-bar {
    display: block;
    width: 26px;
    height: 1.5px;
    background: #E8E2D6;
    transform-origin: right center;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), background 0.3s ease;
  }
  .ham-bar:nth-child(2) { transform: scaleX(0.62); }

  @media (hover: hover) {
    .nav-hamburger:hover .ham-bar:nth-child(2) { transform: scaleX(1); }
  }
  .nav-hamburger[aria-expanded="true"] .ham-bar { background: var(--oro); transform-origin: center; }
  .nav-hamburger[aria-expanded="true"] .ham-bar:nth-child(1) { transform: translateY(4.25px) rotate(45deg); }
  .nav-hamburger[aria-expanded="true"] .ham-bar:nth-child(2) { transform: translateY(-4.25px) rotate(-45deg); }

  /* ── Panel lateral: entra desde la derecha, por debajo de la barra (logo + X siguen visibles) ── */
  .nav-inner { position: relative; z-index: 2; }

  .menu-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 0;
    background: rgba(2, 1, 1, 0.6);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0s linear 0.3s;
  }
  .menu-backdrop.open {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.4s ease, visibility 0s;
  }

  .mobile-menu {
    display: none;
    position: fixed;
    top: 0;
    right: 0;
    z-index: 1;
    width: min(85vw, 420px);
    height: 100dvh;
    box-sizing: border-box;
    flex-direction: column;
    padding: calc(var(--nav-h) + 1.5rem) clamp(1.5rem, 6vw, 2.5rem) 2rem;
    overflow-y: auto;
    background: var(--logo-bg);
    border-left: 1px solid rgba(201, 150, 58, 0.14);
    box-shadow: -24px 0 60px rgba(0, 0, 0, 0.55);
    transform: translateX(100%);
    visibility: hidden;
    transition: transform 0.32s cubic-bezier(0.7, 0, 0.84, 0), visibility 0s linear 0.32s;
  }
  .mobile-menu.open {
    transform: translateX(0);
    visibility: visible;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), visibility 0s;
  }
  .mobile-menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .mobile-menu li {
    opacity: 0;
    transform: translateX(16px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .mobile-menu.open li {
    opacity: 1;
    transform: none;
    transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1) calc(0.12s + var(--i) * 0.05s),
                transform 0.5s cubic-bezier(0.16, 1, 0.3, 1) calc(0.12s + var(--i) * 0.05s);
  }
  .mobile-link {
    display: flex;
    align-items: center;
    min-height: 60px;
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.6rem, 7vw, 2rem);
    color: var(--tinta-2);
    text-decoration: none;
    border-bottom: 1px solid rgba(201, 150, 58, 0.1);
    transition: color 0.2s ease;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  .mobile-link:active,
  .mobile-link.active { color: var(--oro-claro); }
  @media (hover: hover) {
    .mobile-link:hover { color: var(--oro-claro); }
  }
  .mobile-firma {
    margin: auto 0 0;
    padding-top: 2rem;
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    color: var(--tinta-3);
  }

  /* ── Responsive ── */
  @media (max-width: 1023px) {
    .nav-inner { grid-template-columns: 1fr auto; }
    .nav-links { display: none; }
    .nav-hamburger { display: flex; }
    .nav-end { display: flex; }
    .mobile-menu { display: flex; }
    .menu-backdrop { display: block; }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu,
    .mobile-menu.open { transform: none; opacity: 0; transition: opacity 0.2s ease, visibility 0s linear 0.2s; }
    .mobile-menu.open { opacity: 1; transition: opacity 0.2s ease, visibility 0s; }
    .mobile-menu li, .mobile-menu.open li { opacity: 1; transform: none; transition: none; }
    .nav-hamburger[aria-expanded="true"] .ham-bar { transition: background 0.2s ease; }
  }
</style>

<script>
  const header = document.getElementById('navbar') as HTMLElement;
  const btn = document.getElementById('hamburger-btn') as HTMLButtonElement;
  const menu = document.getElementById('mobile-menu') as HTMLElement;
  const backdrop = document.getElementById('menu-backdrop') as HTMLElement;
  const behind = document.querySelectorAll<HTMLElement>('#contenido, footer');

  /* ── Scroll: agrega sombra al bajar ── */
  const updateNavState = () => header.classList.toggle('scrolled', window.scrollY > 40);
  window.addEventListener('scroll', updateNavState, { passive: true });
  updateNavState();

  /* ── Menú móvil: abrir/cerrar con gestión de foco ── */
  const setMenu = (open: boolean, returnFocus = false) => {
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    menu.classList.toggle('open', open);
    menu.toggleAttribute('inert', !open);
    backdrop.classList.toggle('open', open);
    behind.forEach((el) => el.toggleAttribute('inert', open));
    document.documentElement.style.overflow = open ? 'hidden' : '';
    if (open) menu.querySelector<HTMLElement>('[data-mobile-link]')?.focus();
    else if (returnFocus) btn.focus();
  };

  btn.addEventListener('click', () => setMenu(btn.getAttribute('aria-expanded') !== 'true'));

  backdrop.addEventListener('click', () => setMenu(false, true));

  menu.querySelectorAll('[data-mobile-link]').forEach((link) => {
    link.addEventListener('click', () => setMenu(false));
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') setMenu(false, true);
  });

  /* Al pasar a desktop el menú móvil se cierra */
  window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
    if (e.matches) setMenu(false);
  });

  /* ── Ocultar el navbar justo antes del footer ── */
  const footer = document.querySelector('footer');
  if (footer) {
    const footerObserver = new IntersectionObserver(
      ([entry]) => {
        const hide = entry.isIntersecting;
        header.classList.toggle('hidden-by-footer', hide);
        header.toggleAttribute('inert', hide);
        if (hide) setMenu(false);
      },
      // El footer cuenta como visible cuando le faltan 160px para entrar por abajo
      { rootMargin: '0px 0px 160px 0px', threshold: 0 },
    );
    footerObserver.observe(footer);
  }

  /* ── Active link según sección visible ── */
  const sections = document.querySelectorAll('section[id]');
  const navLinkEls = document.querySelectorAll('[data-nav-link], [data-mobile-link]');

  const sectionObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const id = entry.target.id;
        navLinkEls.forEach((el) => {
          const actual = el.getAttribute('href') === `#${id}`;
          el.classList.toggle('active', actual);
          if (actual) el.setAttribute('aria-current', 'location');
          else el.removeAttribute('aria-current');
        });
      });
    },
    { rootMargin: '-40% 0px -40% 0px', threshold: 0 },
  );

  sections.forEach((s) => sectionObserver.observe(s));
</script>
