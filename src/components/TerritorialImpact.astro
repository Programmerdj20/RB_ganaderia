---
// Sección: Impacto Territorial — mapa de Colombia + narrativa
const pilares = [
  {
    titulo:  'Una Potencia Ganadera Continental',
    cuerpo:  'Colombia cuenta con cerca de 29 millones de bovinos repartidos en más de 600.000 predios (FEDEGAN, 2025). La ganadería genera más de 1,09 millones de empleos directos, el mayor aporte al empleo rural del país.',
  },
  {
    titulo:  'Regiones que Sostienen el Hato Nacional',
    cuerpo:  'Los Llanos Orientales —Casanare, Meta, Arauca y Vichada— concentran alrededor del 30 % del inventario bovino del país. La Costa Atlántica y Antioquia completan el triángulo productivo que define la geografía ganadera de Colombia.',
  },
  {
    titulo:  'Biodiversidad y Vocación de Largo Plazo',
    cuerpo:  'La adopción creciente de sistemas silvopastoriles en el territorio nacional combina producción bovina con conservación de suelos, protección de fuentes hídricas y secuestro de carbono, consolidando un modelo ganadero compatible con la biodiversidad colombiana.',
  },
];
---

<section
  id="impacto"
  class="relative py-20 md:py-28 px-5 sm:px-6 bg-superficie-2 border-t border-linea-acento"
  aria-labelledby="impacto-titulo"
>
  <div class="max-w-6xl mx-auto">

    <div class="text-center mb-12 md:mb-20" data-reveal>
      <h2 id="impacto-titulo" class="font-serif text-3xl sm:text-4xl md:text-5xl leading-[1.15] max-w-2xl mx-auto text-tinta text-balance">
        La ganadería, pilar del corazón productivo de Colombia
      </h2>
    </div>

    <div class="grid md:grid-cols-2 gap-12 md:gap-20 items-center">

      <!-- Mapa — puntos luminosos dorados sobre negro -->
      <div class="relative flex items-center justify-center order-2 md:order-1" data-reveal>
        <div class="relative w-full max-w-sm mx-auto">
          <!-- Marco carmesí del mapa — eco del logo -->
          <div class="absolute pointer-events-none border border-linea-acento" style="inset: -12px;" aria-hidden="true"></div>

          <!-- Silueta de Colombia proyectada desde coordenadas geográficas (lon/lat) -->
          <svg
            viewBox="0 0 260 350"
            class="w-full h-auto"
            xmlns="http://www.w3.org/2000/svg"
            role="img"
            aria-labelledby="mapa-titulo mapa-desc"
          >
            <title id="mapa-titulo">Mapa de las principales regiones ganaderas de Colombia</title>
            <desc id="mapa-desc">Silueta de Colombia con cuatro zonas marcadas: Costa Caribe, Antioquia, Magdalena Medio y Llanos Orientales, la región con el mayor hato nacional.</desc>
            <defs>
              <style>
                .dot-pulse   { animation: dotPulse 2.8s ease-in-out infinite; }
                .dot-pulse-b { animation: dotPulse 2.8s ease-in-out infinite 0.7s; }
                .dot-pulse-c { animation: dotPulse 2.8s ease-in-out infinite 1.3s; }
                .dot-pulse-d { animation: dotPulse 2.8s ease-in-out infinite 2.0s; }
                @keyframes dotPulse {
                  0%, 100% { opacity: 1; }
                  50%      { opacity: 0.55; }
                }
                @media (prefers-reduced-motion: reduce) {
                  .dot-pulse, .dot-pulse-b, .dot-pulse-c, .dot-pulse-d { animation: none; }
                }
              </style>
              <filter id="glow-gold" x="-60%" y="-60%" width="220%" height="220%">
                <feGaussianBlur stdDeviation="4" result="blur"/>
                <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
              </filter>
              <filter id="glow-sm" x="-60%" y="-60%" width="220%" height="220%">
                <feGaussianBlur stdDeviation="2.5" result="blur"/>
                <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
              </filter>
            </defs>

            <!-- Silueta de Colombia -->
            <path
              d="M 43,86.6 L 51,97 L 55,99 L 53,87 L 66,74 L 76,57 L 80,51 L 93,41 L 106,34 L 122,34 L 132,28 L 146,21 L 157,11 L 163,23 L 147,38 L 140,54 L 133,74 L 146,81 L 141,100 L 149,120 L 174,120 L 188,121 L 202,138 L 234,136 L 241,146 L 241,164 L 235,184 L 238,202 L 246,216 L 248,224 L 252,235 L 230,226 L 202,239 L 194,246 L 189,263 L 201,282 L 198,304 L 191,344 L 179,336 L 184,314 L 160,306 L 138,308 L 116,288 L 100,268 L 84,263 L 62,253 L 39,247 L 26,241 L 12,231 L 15,218 L 28,208 L 39,189 L 46,181 L 41,163 L 40,148 L 43,137 L 36,124 L 32,115 L 41,102 L 46,93 Z"
              fill="rgba(139,26,26,0.1)"
              stroke="rgba(201,150,58,0.5)"
              stroke-width="1.2"
              stroke-linejoin="round"
            />

            <!-- Costa Caribe (Córdoba · Sucre · Bolívar) -->
            <circle cx="82" cy="82" r="5.5" fill="#C9963A" filter="url(#glow-gold)" class="dot-pulse"/>
            <text x="92" y="79" fill="#F0EBE1" font-size="9.5" font-family="Poppins,sans-serif" font-weight="600">Costa Caribe</text>
            <text x="92" y="90" fill="#E0B86A" font-size="7.5" font-family="Poppins,sans-serif">Córdoba · Sucre · Bolívar</text>

            <!-- Antioquia (FEDEGAN 2025: 3,18 M bovinos) -->
            <circle cx="78" cy="128" r="5" fill="#C9963A" filter="url(#glow-gold)" class="dot-pulse-b"/>
            <text x="68" y="133" fill="#F0EBE1" font-size="9.5" font-family="Poppins,sans-serif" font-weight="600" text-anchor="end">Antioquia</text>
            <text x="68" y="144" fill="#E0B86A" font-size="7.5" font-family="Poppins,sans-serif" text-anchor="end">~3,2 M bovinos</text>

            <!-- Magdalena Medio -->
            <circle cx="102" cy="120" r="3.5" fill="#C2BCB0" filter="url(#glow-sm)" class="dot-pulse-d"/>
            <text x="104" y="109" fill="#C2BCB0" font-size="7.5" font-family="Poppins,sans-serif" text-anchor="middle">Magdalena Medio</text>

            <!-- Llanos Orientales (mayor hato nacional) -->
            <circle cx="154" cy="154" r="7" fill="#C9963A" filter="url(#glow-gold)" class="dot-pulse-c"/>
            <text x="166" y="151" fill="#F0EBE1" font-size="9.5" font-family="Poppins,sans-serif" font-weight="600">Llanos Orientales</text>
            <text x="166" y="162" fill="#E0B86A" font-size="7.5" font-family="Poppins,sans-serif">Casanare · Meta · Arauca</text>
          </svg>
        </div>
      </div>

      <!-- Pilares narrativos -->
      <div class="flex flex-col order-1 md:order-2" data-reveal style="--d: 0.15s;">
        {pilares.map((pilar, i) => (
          <div
            class:list={[
              'py-6 sm:py-8 pl-5 sm:pl-7 border-l border-linea-acento',
              { 'border-b border-b-linea': i < pilares.length - 1 },
            ]}
          >
            <h3 class="font-sans font-semibold text-lg leading-snug mb-3 text-tinta">
              {pilar.titulo}
            </h3>
            <p class="font-body text-base leading-relaxed text-tinta-2" style="text-wrap: pretty;">
              {pilar.cuerpo}
            </p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
