---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Foundation from '../components/Foundation.astro';
import Excellence from '../components/Excellence.astro';
import Gallery from '../components/Gallery.astro';
import TerritorialImpact from '../components/TerritorialImpact.astro';
import GlobalQuality from '../components/GlobalQuality.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <main id="contenido" tabindex="-1" class="outline-none">
    <Hero />
    <Foundation />
    <Excellence />
    <Gallery />
    <TerritorialImpact />
    <GlobalQuality />
  </main>
  <Footer />
</Layout>
